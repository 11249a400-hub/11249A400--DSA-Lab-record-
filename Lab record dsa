---

3. DISPLAY()

1. If top == NULL → Print "Stack empty".


2. Else traverse from top to NULL.


3. Print each node’s data.

CODE:

#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node *top = NULL;

// PUSH operation
void push(int val) {
    struct Node *newnode = (struct Node*)malloc(sizeof(struct Node));
    newnode->data = val;
    newnode->next = top;
    top = newnode;
    printf("Pushed %d\n", val);
}

// POP operation
void pop() {
    if (top == NULL) {
        printf("Stack Underflow\n");
        return;
    }
    struct Node *temp = top;
    printf("Popped %d\n", temp->data);
    top = top->next;
    free(temp);
}

// DISPLAY
void display() {
    if (top == NULL) {
        printf("Stack Empty\n");
        return;
    }
    struct Node *temp = top;
    printf("Stack: ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

